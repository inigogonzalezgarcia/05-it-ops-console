# Copy to .env (never commit .env) and load it in your service manager.
OPS_SECRET_KEY=change-me-to-a-long-random-value
OPS_DATABASE=/var/lib/it-ops-console/console.db
OPS_COOKIE_SECURE=1

# Authentication: demo | ldap
OPS_AUTH_MODE=ldap
OPS_LDAP_URL=ldaps://dc01.example.internal
OPS_LDAP_USER_TEMPLATE={username}@example.internal
OPS_LDAP_SEARCH_BASE=OU=Workstations,DC=example,DC=internal
# Read-only service account used only for computer discovery
OPS_LDAP_BIND_USER=svc-console-read@example.internal
OPS_LDAP_BIND_PASSWORD=

# Email for activation codes and invitations: outbox (demo) | smtp | webhook
OPS_EMAIL_MODE=smtp
OPS_SMTP_HOST=smtp.example.internal
OPS_SMTP_PORT=587
OPS_SMTP_USER=
OPS_SMTP_PASSWORD=
OPS_SMTP_FROM=it-ops-console@example.internal

# Remote queries: demo | powershell
OPS_REMOTE_MODE=powershell
OPS_POWERSHELL=pwsh
# Leave empty to use the identity of the account running the service
OPS_REMOTE_USER=
OPS_REMOTE_PASSWORD=

# Outbound events (for example an n8n webhook)
OPS_WEBHOOK_URL=
OPS_WEBHOOK_SECRET=
OPS_WARRANTY_WARN_DAYS=90
